# Copy to .env (same folder as docker-compose.yml) and edit. All values are optional.
# There are no credentials here: each person signs in to Pelican in their browser.

# Port on the host machine (the container always uses 8765 inside)
PELICAN_HOST_PORT=8765

# Hostnames people type in the browser, comma separated. IP addresses always work.
# Example: PELICAN_ALLOWED_HOSTS=nas.local,pelican.home.lan
PELICAN_ALLOWED_HOSTS=

# Networks treated like "the PC running the app": sign-ins from them are remembered
# in pelican.conf (site list + email, never passwords). Comma separated CIDRs.
# Leave empty and each browser keeps its own site list instead.
# (Quit stays disabled in Docker either way; use `docker compose down`.)
# Example: PELICAN_TRUSTED_NETS=192.168.1.0/24
PELICAN_TRUSTED_NETS=

# Address printed in the container log, e.g. http://192.168.1.50:8765
PELICAN_PUBLIC_URL=

# Container time zone (only affects log timestamps; Pelican data uses each site's own time)
TZ=America/Chicago
